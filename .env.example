# Local RunPod paths. Copy this file to .env on the machine running experiments.
# MODEL_CACHE_DIR is the HF Hub root, not a single model snapshot directory.
MODEL_CACHE_DIR=/workspace/model-cache/huggingface/hub
DATASET_DIR=/workspace/datasets
RESULTS_DIR=/workspace/CSCI544-DLM/results

# The same frozen E0 manifest is reused by both methods and separate invocations.
DATASET_MANIFEST=/workspace/datasets/manifests/gsm8k_e0.json
# Revision used by our previous GSM8K runs. Both train and test must be cached
# at this revision to create the manifest offline on its first run.
# Omit this value to use the revision recorded in an existing E0 manifest.
DATASET_REVISION=740312add88f781978c0658806c59bc2815b9866
